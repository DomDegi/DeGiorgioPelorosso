{
  "branches": ["main"],
  "plugins": [
    "@semantic-release/commit-analyzer",
    "@semantic-release/release-notes-generator",
    [
      "@semantic-release/exec",
      {
        "prepareCmd": "sed -i 's/__version__ = .*/__version__ = \"${nextRelease.version}\"/' src/__init__.py && sed -i 's/\\(\\\\textbf{Version:}\\) [0-9]\\+\\.[0-9]\\+\\.[0-9]\\+/\\1 ${nextRelease.version}/' docs/latex_src/main.tex"      }
    ],
    [
      "@semantic-release/git",
      {
        "assets": ["src/__init__.py", "docs/latex_src/main.tex"],
        "message": "chore(release): sync version to ${nextRelease.version} [skip ci]"
      }
    ],
    "@semantic-release/github"
  ]
}
