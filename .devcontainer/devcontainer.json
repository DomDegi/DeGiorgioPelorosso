{
  "name": "AstraLog-HPC Dev",
  "dockerComposeFile": "./docker-compose.yml",
  "service": "dev-env",
  "workspaceFolder": "/workspace/DegiorgioPelorosso",
  
  "customizations": {
    "vscode": {
      "settings": {
        "python.defaultInterpreterPath": "/usr/local/bin/python",
        "git.enableSmartCommit": true,
        "git.autofetch": true
      },
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance"
      ]
    }
  },
  "mounts": [
    "source=${localEnv:SSH_AUTH_SOCK},target=/ssh-agent,type=bind"
  ],
  "remoteEnv": {
    "SSH_AUTH_SOCK": "/ssh-agent"
  },
  "postStartCommand": "if [ -f requirements.txt ]; then pip install -r requirements.txt; fi"
}