{
  "name": "AstraLog-HPC Dev",
  "dockerComposeFile": "./docker-compose.yml",
  "service": "dev-env",
  "workspaceFolder": "/workspace/DeGiorgioPelorosso",

  "customizations": {
    "vscode": {
      "settings": {
        "python.defaultInterpreterPath": "/usr/local/bin/python",
        "git.enableSmartCommit": true,
        "git.autofetch": true
      },
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "github.vscode-github-actions"
      ]
    }
  },
  "mounts": [
    "source=project-extensions,target=/root/.vscode-server/extensions,type=volume"
  ],
  "postStartCommand": "if [ -f /workspace/requirements_dev.txt ]; then pip install -r /workspace/requirements_dev.txt; fi"
}
